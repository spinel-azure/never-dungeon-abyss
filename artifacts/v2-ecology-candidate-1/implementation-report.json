  "api": {
    "map": "generateV2Ecology({ruleset,seed,level,rarity,themeId})",
    "floor": "generateV2FloorEcology({...input,floorIndex}) (zero-based 0..2)",
    "candidates": "getV2EcologyCandidates(input,floorIndex)",
    "output": "revision,identity,dominantSpeciesId,floors[{floorIndex,species:[{id,weight}],rareSpeciesRate,ecologyTags}],fingerprint",
    "rareSpeciesRateUnit": "basis points / 10000; includes the existing maikaefer as well as the two map-only species"
  },
  "pools": {
    "ordinarySpeciesCount": 47,
    "policy": "Explicit, immutable snapshot of normal enemy IDs with original level/depth/HP/attack/def provenance. Native regional formations receive affinity 6; curated guests 2; selected low-level theme favorites 3; shared low-level residents 1. Boss/event/quest species excluded. Existing global rare maikaefer explicitly allowed despite randomEncounter=false.",
    "caveat": "High-tier themes have no low-level native monsters in existing assets. Low-Lv maps therefore use weak common residents, not high-Lv native monsters or scaled stats. Lv100 does not imply every monster is Lv100."
  },
  "level": "Eligibility enemy.level <= max(5,mapLevel + floorIndex*5). Target proximity max(1,30-abs(enemy.level-target)); map-exclusive metadata uses an eligibility Lv, not combat stats.",
  "rarity": "Rare selection weights only: WHITE x1.00, SILVER x1.10, GOLD x1.20. All inputs also domain-separate RNG. Lv eligibility cannot be bypassed by rarity.",
  "selection": "One map-wide dominant from B1F candidates. Floor counts uniformly B1F 3..4, B2F 3..5, B3F 4..5. Weighted selection without replacement. Species absent from previous floor have x3 selection preference.",
  "weights": "Dominant is 3500..5500 normally. A species-independent map-wide 2% tail uses 7000..9600. Remaining weight uses uniform integers 1..100; B2F multiplies by ceil(speciesLevel/5)^2, B3F by that tier^3. Positive largest-remainder allocation totals exactly 10000. The designated dominant is a shared anchor, not guaranteed the largest species on every normal floor.",
